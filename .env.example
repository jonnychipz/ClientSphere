# Hubble — Azure config template. Copy to .env and adjust.
# Auth is keyless (Entra ID via DefaultAzureCredential) — no API keys here.
PORT=3000

# Foundry project (gpt-5.4 agent)
PROJECT_ENDPOINT=https://hubble-foundry.services.ai.azure.com/api/projects/hubble-proj
MODEL_DEPLOYMENT=gpt-5.4

# Azure Speech (voice + talking avatar) — keyless AAD via custom-domain token exchange.
SPEECH_REGION=swedencentral
SPEECH_STS_ENDPOINT=https://hubble-foundry.cognitiveservices.azure.com/sts/v1.0/issueToken

# Filled in by `npm run setup`
AGENT_ID=
VECTOR_STORE_ID=

# ---------------------------------------------------------------------------
# Custom avatar + voice (YOUR likeness) — see custom-avatar/README.md.
# Disabled until ENABLED=true AND a character or voice is set.
# ---------------------------------------------------------------------------
CUSTOM_AVATAR_ENABLED=false
CUSTOM_AVATAR_LABEL=You (custom)
CUSTOM_AVATAR_GENDER=male
CUSTOM_AVATAR_CHARACTER=        # custom avatar model name from Foundry (video or photo)
CUSTOM_AVATAR_STYLE=           # video avatar style only; blank for photo avatar
CUSTOM_AVATAR_PHOTO_MODEL=     # photo avatar base model, e.g. vasa-1; blank for video avatar
CUSTOM_VOICE_NAME=            # your Custom Neural Voice deployment name, e.g. en-GB-JohnNeural
