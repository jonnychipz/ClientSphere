# ClientSphere local configuration. Copy to .env and adjust.
# Auth is keyless (Entra ID via DefaultAzureCredential) — no API keys here.
PORT=3000

# Foundry project and latest model mix
PROJECT_ENDPOINT=https://clientsphere-ai-95bc.services.ai.azure.com/api/projects/clientsphere-project
MODEL_DEPLOYMENT=gpt-5.6-sol
GENERAL_MODEL_DEPLOYMENT=gpt-5.6-sol
USE_CASE_MODEL_SOL=gpt-5.6-sol
USE_CASE_MODEL_LUNA=gpt-5.6-luna
USE_CASE_MODEL_TERRA=gpt-5.6-terra

# Azure Speech (voice + talking avatar) — keyless AAD via custom-domain token exchange.
SPEECH_REGION=swedencentral
SPEECH_STS_ENDPOINT=https://clientsphere-ai-95bc.cognitiveservices.azure.com/sts/v1.0/issueToken

# `npm run agents:provision` writes this file locally. The deployment image
# includes the generated file.
CUSTOMER_AGENT_META_PATH=customer-agents.json

# Authentication (GitHub OAuth). Create an OAuth App at
# https://github.com/settings/developers (callback http://localhost:3000/auth/callback).
# Blank or AUTH_DEV_MODE=true => DEV MODE (simulated username login) for testing.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_DEV_MODE=true
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_LOGINS=jonnychipz

# Email approval workflow (Azure Communication Services). Blank => emails disabled.
ACS_CONNECTION_STRING=
EMAIL_SENDER=DoNotReply@<your-managed-domain>.azurecomm.net
ADMIN_EMAIL=johnlunn@microsoft.com
ADMIN_NAME=John Lunn
PUBLIC_BASE_URL=http://localhost:3000

# Durable storage (Azure Table Storage, keyless via managed identity / az login).
# Set to the storage account NAME. Blank => local JSON file fallback for dev.
AZURE_STORAGE_ACCOUNT=


# ---------------------------------------------------------------------------
# Custom avatar + voice (YOUR likeness) — see custom-avatar/README.md.
# Disabled until assets are available and ENABLED=true.
# ---------------------------------------------------------------------------
CUSTOM_AVATAR_ENABLED=false
CUSTOM_AVATAR_LABEL=You (custom)
CUSTOM_AVATAR_GENDER=male
CUSTOM_BODY_CHARACTER=harry     # standard male body paired with your voice
CUSTOM_BODY_STYLE=business
CUSTOM_AVATAR_CHARACTER=        # custom FACE avatar model (your likeness); blank to use standard body
CUSTOM_AVATAR_STYLE=           # video avatar style only; blank for photo avatar
CUSTOM_AVATAR_PHOTO_MODEL=     # photo avatar base model, e.g. vasa-1; blank for video avatar
CUSTOM_VOICE_NAME=            # your Custom Neural Voice name, e.g. en-GB-JonnychipzNeural
CUSTOM_VOICE_ENDPOINT_ID=     # CNV deployment/endpoint id (required to use a custom voice)
